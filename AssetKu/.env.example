# Contoh file environment variables untuk AssetKu.
# Salin file ini menjadi ".env" lalu sesuaikan nilainya jika diperlukan.
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)

# Lokasi file database SQLite. Untuk deployment di VPS, biarkan default ini
# kecuali Anda ingin menyimpan file database di lokasi lain di server.
DATABASE_URL="file:./dev.db"

# Port yang dipakai aplikasi saat dijalankan dengan "npm start" (opsional,
# default Next.js adalah 3000). Berguna saat menjalankan beberapa aplikasi
# Node.js sekaligus di satu VPS.
PORT=3000
