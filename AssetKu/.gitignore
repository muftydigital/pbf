# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Catatan: .env TIDAK di-ignore karena tidak berisi data rahasia,
# hanya path database SQLite lokal. Ini memudahkan reviewer/CodeSandbox
# menjalankan project tanpa perlu setup manual.
.env.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database SQLite yang di-generate saat migrasi (tidak perlu ikut di-commit)
/prisma/dev.db
/prisma/dev.db-journal
